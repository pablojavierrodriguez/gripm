#!/bin/sh
# gripm Pre-Commit Hook: verificación condicional del Backlog (DEV-159)
#
# CONTRATO: este hook VERIFICA, nunca muta.
# No escribe en el índice de git ni incluye archivos no stageados.
#
# VALIDACIÓN CONDICIONAL: solo evalúa el backlog si el commit incluye cambios
# en BACKLOG.md o en backlog/tasks/*. Si el commit es de solo código, documentación
# o refactor, pasa directamente sin fricción.
#
# Si BACKLOG.md queda desfasado, el propio commit lo mostrará como modificado
# y vos decidís si lo incluís. No hace falta --no-verify.

echo "🛡️  [gripm Pre-Commit] Verificando coherencia del Backlog con el código..."

node scripts/verify-backlog-sync.js --hook
RESULT=$?

if [ $RESULT -ne 0 ]; then
  echo ""
  echo "❌ Commit rechazado por gripm Backlog Guard."
  echo "   Hay tareas o documentación desfasadas respecto al código."
  echo ""
  echo "   Para resolverlo:"
  echo "     npm run backlog:sync    # auto-reconcilia las tareas"
  echo "     npm run backlog:check   # revalida"
  echo ""
  echo "   Una vez resuelto, repetí el commit. No hace falta --no-verify:"
  echo "   este hook no modifica lo que stageaste."
  echo ""
  exit 1
fi

echo "✅ Coherencia verificada."
exit 0
