{
  "theme": "dark",
  "density": "comfortable",
  "autoSave": true,
  "kanban": {
    "showIdeasByDefault": false,
    "showDoneHistoryByDefault": false,
    "wipLimits": {
      "col-doing": 0,
      "col-review": 0,
      "col-ready": 0
    },
    "columns": [
      {
        "id": "col-draft",
        "title": "Draft",
        "subtitle": "Backlog & Triaged",
        "color": "border-slate-300 dark:border-slate-700/60",
        "dotColor": "bg-indigo-500",
        "statuses": [
          "draft"
        ],
        "dropTargetStatus": "draft"
      },
      {
        "id": "col-doing",
        "title": "Doing",
        "subtitle": "Desarrollo activo",
        "color": "border-amber-500/30",
        "dotColor": "bg-amber-500",
        "statuses": [
          "doing"
        ],
        "dropTargetStatus": "doing"
      },
      {
        "id": "col-review",
        "title": "Review",
        "subtitle": "Testing & Code Review",
        "color": "border-purple-500/30",
        "dotColor": "bg-purple-500",
        "statuses": [
          "review"
        ],
        "dropTargetStatus": "review"
      },
      {
        "id": "col-ready",
        "title": "Ready",
        "subtitle": "Ready for deploy",
        "color": "border-teal-500/30",
        "dotColor": "bg-teal-500",
        "statuses": [
          "ready"
        ],
        "dropTargetStatus": "ready"
      },
      {
        "id": "col-done",
        "title": "Done",
        "subtitle": "Deployed & Cerrado",
        "color": "border-emerald-500/30",
        "dotColor": "bg-emerald-500",
        "statuses": [
          "done"
        ],
        "dropTargetStatus": "done"
      }
    ],
    "simplifiedColumns": [
      {
        "id": "col-draft",
        "title": "Backlog",
        "subtitle": "Priorizado y Refinado",
        "color": "border-slate-300 dark:border-slate-700/60",
        "dotColor": "bg-indigo-500",
        "statuses": [
          "draft"
        ],
        "dropTargetStatus": "draft"
      },
      {
        "id": "col-doing",
        "title": "In Progress",
        "subtitle": "Doing & Review",
        "color": "border-amber-500/30",
        "dotColor": "bg-amber-500",
        "statuses": [
          "doing",
          "review"
        ],
        "dropTargetStatus": "doing"
      },
      {
        "id": "col-done",
        "title": "Done",
        "subtitle": "Deployed & Liberado",
        "color": "border-emerald-500/30",
        "dotColor": "bg-emerald-500",
        "statuses": [
          "ready",
          "done"
        ],
        "dropTargetStatus": "ready"
      }
    ]
  },
  "version": "1.0.0",
  "mode": "multi",
  "language": "en",
  "projectName": "gripm",
  "projectId": "gripm",
  "codePrefix": "DEV",
  "methodology": "kanban",
  "enabledTabs": {
    "kanban": true,
    "sprint": false,
    "release": true
  },
  "locale": "en",
  "defaultView": "kanban",
  "modules": {
    "sprint": true,
    "release": true,
    "calendar": false
  },
  "rankingEnabled": true,
  "customItemTypes": [],
  "calendarExport": false,
  "estimation": {
    "enabled": false,
    "method": "fibonacci"
  },
  "visibleCardMetadata": {
    "module": true,
    "sprint": true,
    "release": true,
    "acProgress": true,
    "priority": true,
    "parent": true,
    "blocked": true,
    "estimate": true
  }
}