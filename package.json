{
  "name": "@gripm/board",
  "version": "1.10.0",
  "description": "Agile engineering & Product Management cockpit for AI pair programming: Markdown-backed backlog, MCP server and CLI for developers and autonomous agents.",
  "keywords": [
    "gripm",
    "agile",
    "product-management",
    "kanban",
    "backlog",
    "sprint",
    "task-management",
    "ai",
    "llm",
    "agent",
    "mcp",
    "model-context-protocol",
    "markdown",
    "cli",
    "devtools",
    "developer-tools",
    "pair-programming"
  ],
  "author": "gripm Contributors",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pablojavierrodriguez/gripm.git"
  },
  "homepage": "https://github.com/pablojavierrodriguez/gripm#readme",
  "bugs": {
    "url": "https://github.com/pablojavierrodriguez/gripm/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=20.0.0",
      "onFail": "error"
    }
  },
  "type": "module",
  "files": [
    ".agents/skills/gripm",
    "bin",
    "dist",
    "public",
    "data/demo-backlog.json",
    "LICENSE",
    "README.md",
    "README.es.md"
  ],
  "bin": {
    "gripm": "bin/gripm.js",
    "gripm-mcp": "bin/gripm-mcp.js",
    "board": "bin/gripm.js"
  },
  "scripts": {
    "dev": "vite",
    "gripm": "node bin/gripm.js",
    "board": "node bin/gripm.js",
    "build": "tsc && vite build && node scripts/build-binaries.js",
    "build:bin": "node scripts/build-binaries.js",
    "preview": "vite preview",
    "import:docs": "node scripts/import-docs.js",
    "test": "node scripts/run-tests.js",
    "test:ui": "node scripts/test-ui-smoke.js",
    "test:backlog": "node --experimental-strip-types scripts/verify-integration.js",
    "verify:dist": "node scripts/verify-dist.js",
    "mcp": "node bin/gripm-mcp.js",
    "tasks": "node --experimental-strip-types scripts/gripm-cli.ts list --open",
    "backlog:check": "node scripts/verify-backlog-sync.js",
    "gate:review": "node scripts/gate-review-items.mjs",
    "backlog:sync": "node scripts/verify-backlog-sync.js --fix",
    "playbook:check": "node scripts/sync-playbook.mjs --dry-run",
    "playbook:sync": "node scripts/sync-playbook.mjs",
    "backlog:purge-fabricated": "node scripts/purge-fabricated-task-sections.js",
    "backlog:canonicalize-status": "node --experimental-strip-types scripts/canonicalize-status.js",
    "publish:check": "node scripts/verify-publish-surface.js",
    "audit:ux": "node scripts/audit-ux-code.cjs",
    "audit:ux:strict": "npm run audit:ux -- --strict",
    "audit:ux:baseline": "node scripts/audit-ux-code.cjs --update-baseline",
    "audit:deps": "npm audit --audit-level=critical",
    "changelog": "node scripts/generate-changelog.cjs",
    "lint": "tsc --noEmit",
    "format": "node scripts/verify-backlog-sync.js --fix",
    "deploy:prod": "node scripts/deploy-prod.js",
    "prepublishOnly": "npm run build && npm run publish:check",
    "prepack": "node scripts/prepack-strip-scripts.js",
    "postpack": "node scripts/postpack-restore-scripts.js",
    "prepare": "node scripts/prepare-hooks.js",
    "test:linux": "bash scripts/repro-ci-linux.sh",
    "verify:changes": "node scripts/verify-changes.js",
    "validate": "npm run verify:changes -- --all"
  },
  "dependencies": {
    "lucide-react": "^1.56.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.64.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.5.4",
    "vite": "^5.4.21"
  }
}
